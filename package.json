{
  "name": "opportunity-os",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "workspaces": [
    "frontend",
    "backend"
  ],
  "scripts": {
    "start": "node backend/src/server.js",
    "dev": "concurrently -k -p \"[{name}]\" -n \"CLIENT,SERVER\" -c \"cyan.bold,magenta.bold\" \"npm --prefix frontend run dev\" \"node backend/src/server.js\"",
    "dev:client": "npm --prefix frontend run dev",
    "dev:frontend": "npm --prefix frontend run dev",
    "dev:backend": "node backend/src/server.js",
    "server": "node backend/src/server.js",
    "build": "npm --prefix frontend run build",
    "preview": "npm --prefix frontend run preview",
    "lint": "eslint .",
    "test": "vitest run",
    "audit:production": "npm audit --omit=dev --audit-level=high"
  },
  "dependencies": {
    "bcryptjs": "^3.0.3",
    "concurrently": "^9.2.1",
    "cors": "^2.8.6",
    "dotenv": "^17.2.4",
    "express": "^4.22.1",
    "express-rate-limit": "^8.7.2",
    "jsonwebtoken": "^9.0.3",
    "lucide-react": "^1.61.0",
    "mongoose": "^9.3.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@vitejs/plugin-react": "^6.2.1",
    "eslint": "^10.14.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.7",
    "globals": "^17.14.0",
    "vite": "^8.3.5",
    "vitest": "^5.1.0"
  }
}
